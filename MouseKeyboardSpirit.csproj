<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PackageIcon>TCT_Icon-1.png</PackageIcon>
    <ApplicationIcon>image\TCT_Icon-1.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="image\Close-1.png" />
    <None Remove="image\Folder1.png" />
    <None Remove="image\Folder2.png" />
    <None Remove="image\Hide1.png" />
    <None Remove="image\Pull.png" />
    <None Remove="image\Push.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="image\Close-1.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="image\Folder1.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="image\Folder2.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="image\Hide1.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="image\Pull.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="image\Push.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="image\TCT_Icon-1.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="image\TCT_Icon-1.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\My\ILogger\ILogger.csproj" />
    <ProjectReference Include="..\My\Judgment\Judgment.csproj" />
    <ProjectReference Include="..\My\OLogger\OLogger.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="image\OSE-LOGO_CC-white-1.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="image\TCT_Icon-1.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="image\TCT_Icon-1.psd">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
